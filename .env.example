OPENAI_API_KEY=sk-your-key
TARGET_NUMBER=91YOURNUMBER

# Optional. Protects /qr, /run, /logout, and /clear-locks.
MANUAL_RUN_TOKEN=

# Local defaults to true. Railway defaults to false to avoid Chromium profile locks.
PERSIST_WHATSAPP_SESSION=false

# Optional. Use only for one Railway redeploy if Chromium profile locks are stale.
CLEAR_CHROME_LOCKS=false
